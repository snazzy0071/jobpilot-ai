# Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
# Not secret (this key is meant to be public — RLS is the real
# boundary), but still a real project reference, so this example file
# uses a generic placeholder rather than naming a specific project.
NEXT_PUBLIC_SUPABASE_URL=https://bjibvpgdokifsknngtak.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_FSmJtGOa4iBHr18IlO28CA_9Gpt9cT7
SUPABASE_SERVICE_ROLE_KEY=sb_secret_9UUdgdjJjRM8eYhuOuCCbQ_lrfLMhd2


# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Anthropic (AI features — src/lib/ai/): https://console.anthropic.com/settings/keys
# Secret — server-only, never exposed to the browser.
ANTHROPIC_API_KEY=sk-ant-your-api-key
# Optional — defaults to claude-sonnet-5 (src/lib/ai/config.ts) if unset.
ANTHROPIC_MODEL=claude-sonnet-5

# Stripe: https://dashboard.stripe.com/apikeys
# Secret — server-only, never exposed to the browser.
STRIPE_SECRET_KEY=sk_test_your-secret-key
# From the webhook endpoint's settings once created: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
# Price ids (not secret, but resolved server-side only — the client never
# sends a price id or amount, only a plan slug). One per paid plan per
# billing cycle: https://dashboard.stripe.com/products
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_PREMIUM_MONTHLY=price_...
STRIPE_PRICE_PREMIUM_ANNUAL=price_...
STRIPE_PRICE_ELITE_MONTHLY=price_...
STRIPE_PRICE_ELITE_ANNUAL=price_...
# A one-time (not recurring) Price — Elite's "buy more voice interviews"
# top-up (src/lib/interviews/topup-actions.ts). Must be created in Stripe
# as one-time, not recurring, or Checkout Session creation (mode:
# "payment") will fail.
STRIPE_PRICE_VOICE_TOPUP=price_...

# Resend (transactional email — src/lib/email/): https://resend.com/api-keys
# Secret — server-only, never exposed to the browser.
RESEND_API_KEY=re_your-api-key
# Must be on a domain verified with Resend: https://resend.com/domains
RESEND_FROM_EMAIL=reports@jobpilotai.com

# Voice interviews (src/lib/voice/) — speech-to-text and text-to-speech
# behind a provider abstraction (STT_PROVIDER/TTS_PROVIDER pick the
# implementation; only one of each is built today, more can be added
# under src/lib/voice/providers/ without touching call sites). Only
# needed once a voice-mode interview session is actually started — a
# chat-only deployment can leave all of these unset.

# Speech-to-text: OpenAI Whisper: https://platform.openai.com/api-keys
# Secret — server-only, never exposed to the browser.
OPENAI_API_KEY=sk-your-api-key
# Optional — "openai" is currently the only implemented STT provider.
STT_PROVIDER=openai

# Text-to-speech: ElevenLabs: https://elevenlabs.io/app/settings/api-keys
# Secret — server-only, never exposed to the browser.
ELEVENLABS_API_KEY=sk_your-api-key
# Required once TTS_PROVIDER=elevenlabs — the id of a specific voice from
# your ElevenLabs Voice Library (https://elevenlabs.io/app/voice-library).
# Pick one with a British English accent for this feature's "British
# voice" interviewer; there's no safe default to guess, since a voice id
# is account-specific.
ELEVENLABS_VOICE_ID=your-british-voice-id
# Optional — "elevenlabs" is currently the only implemented TTS provider.
TTS_PROVIDER=elevenlabs


# Jobs (src/lib/jobs/) — external job-listing sources normalized into
# public.jobs (migration 0059). Each source is its own adapter under
# src/lib/jobs/adapters/.

# Adzuna (src/lib/jobs/adapters/adzuna/): https://developer.adzuna.com/
# Secrets — server-only, never exposed to the browser. Required once
# anything calls syncAdzunaJobs() or GET /api/cron/jobs-sync-adzuna; a
# deployment that never syncs jobs can leave both unset.
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key

# Reed (src/lib/jobs/adapters/reed/): https://www.reed.co.uk/developers/jobseeker
# Secret — server-only, never exposed to the browser. Sent as the
# username in HTTP Basic Auth (Reed's own scheme — password left
# blank), so it never appears in a request URL the way Adzuna's
# app_id/app_key do. Required once anything calls syncReedJobs() or
# GET /api/cron/jobs-sync-reed; a deployment that never syncs jobs can
# leave it unset.
REED_API_KEY=your-reed-api-key

# Shared secret every /api/cron/* route checks (jobs-sync-adzuna,
# jobs-sync-reed, jobs-maintenance, dispatch-reminders,
# purge-expired-data — see vercel.json for the actual schedule) — each
# one fails closed (503) if this is unset, and the scheduler sends it as
# `Authorization: Bearer <value>`. Required for any of those routes to
# accept a request; generate with e.g. `openssl rand -hex 32`.
CRON_SECRET=your-cron-secret